#!/usr/bin/env python3
"""CLI entry for installed and checkout layouts."""
from __future__ import annotations

import sys
from pathlib import Path


def _ensure_package_path() -> None:
    here = Path(__file__).resolve().parent
    candidates = [
        here,  # git checkout: ./ricoh-lanfax next to ricoh_lanfax/
        Path("/usr/local/share/ricoh-lanfax"),  # production install / .deb
    ]
    for folder in candidates:
        if (folder / "ricoh_lanfax" / "__init__.py").exists():
            path = str(folder)
            if path not in sys.path:
                sys.path.insert(0, path)
            return


_ensure_package_path()

from ricoh_lanfax.__main__ import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
